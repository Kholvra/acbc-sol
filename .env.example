# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# DATABASE_URL: used by Prisma Client for runtime queries
DATABASE_URL="postgresql://postgres:password@localhost:5432/rework-aid-beacon"
# DIRECT_URL: used by Prisma CLI for migrations and introspection (not runtime)
# In development, typically same as DATABASE_URL
DIRECT_URL="postgresql://postgres:password@localhost:5432/rework-aid-beacon"

# Pinata IPFS
# Get your JWT token from: https://app.pinata.cloud/settings/api-keys
# 1. Sign up at pinata.cloud
# 2. Go to Settings → API Keys
# 3. Create new API Key with Admin permissions
# 4. Copy the JWT token
NEXT_PUBLIC_PINATA_JWT=""

# Pinata Gateway URL
# Use default public gateway or your custom gateway
NEXT_PUBLIC_GATEWAY_URL="https://gateway.pinata.cloud"
