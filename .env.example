# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# Generate with: npx auth secret
AUTH_SECRET=""

# Prisma / PostgreSQL
# For Vercel: use Supabase, Neon, or Railway PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Pinata IPFS
# Get from: https://app.pinata.cloud/settings/api-keys
VITE_PINATA_API_KEY=""
VITE_PINATA_SECRET=""
VITE_PINATA_JWT=""
VITE_GATEWAY_URL="https://gateway.pinata.cloud"

# Next.js public vars (mapped from VITE_ equivalents above)
NEXT_PUBLIC_PINATA_JWT=""
NEXT_PUBLIC_GATEWAY_URL=https://gateway.pinata.cloud
NEXT_PUBLIC_VIDEOSDK_API_KEY=""
VIDEOSDK_SECRET_KEY=""

# Solana Devnet
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_PROGRAM_ID="CiR2MzoqMxztJzvUsMbZJ3FtPZCZ3DX7WwTnh7FW7Cmn"
NEXT_PUBLIC_IDRX_MINT="2PqiXtPxAm8LGPhjkNPJCyFxNBKhZ5kdEbdat6cxD8rj"

# VideoSdk (for livestreaming)
VITE_VIDEOSDK_API_KEY=""
VITE_VIDEOSDK_SECRET_KEY=""

# Supabase (optional)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Groq AI
GROQ_API_KEY=""

# Faucet (serverless deploy)
# Encode keypair JSON bytes as base64: node -e "console.log(Buffer.from(JSON.stringify(require('fs').readFileSync('path/to/keypair.json','utf8'))).toString('base64'))"
# Or leave empty to use local file path (dev only)
FAUCET_SECRET_KEY=""
# FAUCET_KEYPAIR_PATH=""

# EVM (legacy, not used on Solana branch)
NEXT_PUBLIC_FACTORY_ADDRESS=""
NEXT_PUBLIC_IDRX_ADDRESS=""
